@model EmpDeptViewModel
@{
	ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<form method="post" action="/Employee/SaveEdit/@Model.Id">
	<div>
		<label>Id</label>
		<input value="@Model.Id" id="Id" name="Id" class="form-control" />
		<span asp-validation-for="Id" class="text-danger"></span>
	</div>
	<div>
		<label>Name</label>
		<input value="@Model.Name" id="Name" name="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>

	</div><div>
		<label>Address</label>
		<input value="@Model.Address" id="Address" name="Address" class="form-control" />
		<span asp-validation-for="Address" class="text-danger"></span>
	</div><div>
		<label>Number</label>
		<input value="@Model.Number" id="Number" name="Number" class="form-control" />
		<span asp-validation-for="Number" class="text-danger"></span>

	</div><div>
		<label>DepartmentId</label>
		@* <input value="@Model.DepartmentId" id="DepartmentId" name="DepartmentId" class="form-control" /> *@
		<select id="DepartmentId" name="DepartmentId" class="form-control">
			@foreach (var item in Model.Departments)
			{
				if (Model.DepartmentId == item.Id)
				{
					<option value="@item.Id" selected>@item.Name</option>
				}
				else
				{
					<option value="@item.Id">@item.Name</option>
				}
			}
		</select>
	</div>
	<input type="submit" value="Save" class="btn btn-primary" />
</form>