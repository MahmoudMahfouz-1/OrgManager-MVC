@model List<Department>
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<a href="/department/addDepartment" class="btn btn-success">Add Department</a>
<table class="table table-hover table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Manager Name</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.ManagerName</td>
        </tr>

    }
</table>


